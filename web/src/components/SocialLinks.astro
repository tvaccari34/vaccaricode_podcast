---
// Icon + name links to the social profiles (src/lib/social.js). `variant="compact"` drops the
// pill styling for the footer.
import { SOCIAL } from "../lib/social.js";
const { variant = "pill" } = Astro.props;
---
<ul class:list={["social", variant]}>
  {SOCIAL.map((s) => (
    <li>
      <a href={s.url} rel="me noopener" target="_blank" aria-label={`${s.name} ${s.handle}`}>
        {s.id === "youtube" && (
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="4" />
            <path d="M10 9l5 3-5 3z" fill="currentColor" />
          </svg>
        )}
        {s.id === "instagram" && (
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
          </svg>
        )}
        <span>{s.name}</span>
      </a>
    </li>
  ))}
</ul>
